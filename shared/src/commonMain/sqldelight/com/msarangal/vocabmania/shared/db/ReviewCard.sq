CREATE TABLE review_card (
    word_id INTEGER PRIMARY KEY REFERENCES word(id) ON DELETE CASCADE,
    next_review_at INTEGER NOT NULL,
    interval_days REAL NOT NULL DEFAULT 0,
    last_reviewed_at INTEGER,
    review_count INTEGER NOT NULL DEFAULT 0
);

selectByWordId:
SELECT * FROM review_card WHERE word_id = ?;

selectDue:
SELECT
    word.id,
    word.text,
    word.meaning,
    word.usage_example,
    word.level,
    word.is_favorite,
    review_card.word_id,
    review_card.next_review_at,
    review_card.interval_days,
    review_card.last_reviewed_at,
    review_card.review_count
FROM review_card
INNER JOIN word ON word.id = review_card.word_id
WHERE review_card.next_review_at <= ?
AND word.level = ?
ORDER BY review_card.next_review_at ASC
LIMIT ?;

countDue:
SELECT COUNT(*)
FROM review_card
INNER JOIN word ON word.id = review_card.word_id
WHERE review_card.next_review_at <= ?
AND word.level = ?;

insertReviewCard:
INSERT OR REPLACE INTO review_card(word_id, next_review_at, interval_days, last_reviewed_at, review_count)
VALUES (?, ?, ?, ?, ?);

updateReviewCard:
UPDATE review_card
SET next_review_at = ?, interval_days = ?, last_reviewed_at = ?, review_count = ?
WHERE word_id = ?;
