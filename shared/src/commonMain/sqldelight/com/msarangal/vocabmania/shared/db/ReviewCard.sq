CREATE TABLE review_card (
    word_id INTEGER PRIMARY KEY REFERENCES word(id) ON DELETE CASCADE,
    next_review_at INTEGER NOT NULL,
    interval_days REAL NOT NULL DEFAULT 0,
    last_reviewed_at INTEGER,
    review_count INTEGER NOT NULL DEFAULT 0,
    ease_factor REAL NOT NULL DEFAULT 2.5
);

selectByWordId:
SELECT * FROM review_card WHERE word_id = ?;

selectDue:
SELECT
    word.id,
    word.text,
    word.meaning,
    word.usage_example,
    word.level,
    word.is_favorite,
    review_card.word_id,
    review_card.next_review_at,
    review_card.interval_days,
    review_card.last_reviewed_at,
    review_card.review_count,
    review_card.ease_factor
FROM review_card
INNER JOIN word ON word.id = review_card.word_id
WHERE review_card.next_review_at <= :nowEpochMillis
AND word.level = :level
AND (:favoritesOnlyFilter = 0 OR word.is_favorite = 1)
ORDER BY review_card.next_review_at ASC
LIMIT :limit;

countDue:
SELECT COUNT(*)
FROM review_card
INNER JOIN word ON word.id = review_card.word_id
WHERE review_card.next_review_at <= :nowEpochMillis
AND word.level = :level
AND (:favoritesOnlyFilter = 0 OR word.is_favorite = 1);

insertReviewCard:
INSERT OR REPLACE INTO review_card(word_id, next_review_at, interval_days, last_reviewed_at, review_count, ease_factor)
VALUES (?, ?, ?, ?, ?, ?);

updateReviewCard:
UPDATE review_card
SET next_review_at = ?, interval_days = ?, last_reviewed_at = ?, review_count = ?, ease_factor = ?
WHERE word_id = ?;

countReviewedByLevel:
SELECT COUNT(*)
FROM review_card
INNER JOIN word ON word.id = review_card.word_id
WHERE word.level = ?
AND review_card.review_count > 0;

countMatureByLevel:
SELECT COUNT(*)
FROM review_card
INNER JOIN word ON word.id = review_card.word_id
WHERE word.level = ?
AND review_card.review_count > 0
AND review_card.interval_days >= ?;

countActivitySince:
SELECT COUNT(*)
FROM review_card
INNER JOIN word ON word.id = review_card.word_id
WHERE word.level = ?
AND review_card.last_reviewed_at IS NOT NULL
AND review_card.last_reviewed_at >= ?;

countReviewedOnDay:
SELECT COUNT(*)
FROM review_card
INNER JOIN word ON word.id = review_card.word_id
WHERE word.level = ?
AND review_card.last_reviewed_at >= ?
AND review_card.last_reviewed_at < ?;
